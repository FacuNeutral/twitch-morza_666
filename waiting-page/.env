# --- NUEVOS EFECTOS DE ANALOG CRT ---
# Activar/Desactivar el temblequeo de pantalla y parpadeo de brillo (cada 3s durante 4s de estabilidad)
VITE_CRT_SHAKE_AND_FLASH=true

# Activar/Desactivar el efecto de glitch / pérdida de señal (se apaga y prende rápidamente cada 20s)
VITE_CRT_SIGNAL_GLITCH=true

# --- FONDO DE VIDEO O IMAGEN ---
# Activar para usar video (main.mp4) de fondo en vez de imagen (main.png)
# Por defecto se activa la imagen (false)
VITE_USE_VIDEO_BG=false
